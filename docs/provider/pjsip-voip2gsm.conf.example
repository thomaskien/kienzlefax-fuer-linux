; voip2gsm, Fax und Telefonie mit getrennten Konten und Zielnummern.
; Registrar laut Kundencenter, Vorgabe b.vsip.eu. DIDs als Ziffern einsetzen.
; Der Installer generiert diese Objekte. Das Beispiel dient zum Abgleich.

[kfx-provider]
type=registration
transport=transport-udp
outbound_auth=kfx-provider-auth
server_uri=sip:b.vsip.eu
client_uri=sip:CHANGE_ME_FAX_USER@b.vsip.eu
contact_user=CHANGE_ME_FAX_DID
line=yes
endpoint=kfx-provider-endpoint
retry_interval=60
forbidden_retry_interval=600
expiration=300

[kfx-provider-auth]
type=auth
auth_type=userpass
username=CHANGE_ME_FAX_USER
password=CHANGE_ME_FAX_PASSWORD

[kfx-provider-aor]
type=aor
contact=sip:b.vsip.eu

[kfx-provider-endpoint]
type=endpoint
transport=transport-udp
context=kfx-provider-in
disallow=all
allow=alaw,ulaw
outbound_auth=kfx-provider-auth
aors=kfx-provider-aor
from_user=CHANGE_ME_FAX_USER
from_domain=b.vsip.eu
direct_media=no
rewrite_contact=yes
rtp_symmetric=yes
force_rport=yes

[kfx-provider-identify]
type=identify
endpoint=kfx-provider-endpoint
match=b.vsip.eu

[kfx-phone-in-registration]
type=registration
transport=transport-udp
outbound_auth=kfx-phone-in-auth
server_uri=sip:b.vsip.eu
client_uri=sip:CHANGE_ME_PHONE_USER@b.vsip.eu
contact_user=CHANGE_ME_PHONE_DID
line=yes
endpoint=kfx-phone-in-endpoint
retry_interval=60
forbidden_retry_interval=600
expiration=300

[kfx-phone-in-auth]
type=auth
auth_type=userpass
username=CHANGE_ME_PHONE_USER
password=CHANGE_ME_PHONE_PASSWORD

[kfx-phone-in-aor]
type=aor
contact=sip:b.vsip.eu

[kfx-phone-in-endpoint]
type=endpoint
transport=transport-udp
context=kfx-provider-in
disallow=all
allow=alaw,ulaw
outbound_auth=kfx-phone-in-auth
aors=kfx-phone-in-aor
from_user=CHANGE_ME_PHONE_USER
from_domain=b.vsip.eu
direct_media=no
rewrite_contact=yes
rtp_symmetric=yes
force_rport=yes

[kfx-phone-in-identify]
type=identify
endpoint=kfx-phone-in-endpoint
match=b.vsip.eu
